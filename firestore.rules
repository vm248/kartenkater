rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /rooms/{roomId} {
      allow read: if true;
      allow create: if validNewRoom();
      allow update: if validRoomUpdate();
      allow delete: if request.auth != null
                    || resource.data.playerOrder.size() <= 1
                    || request.time.toMillis() > resource.data.createdAt + 86400000;
    }

    match /quadrat/{roomId} {
      allow read: if true;
      allow create: if validNewQuadrat();
      allow update: if validQuadratUpdate();
      allow delete: if request.auth != null
                    || resource.data.playerOrder.size() <= 1
                    || request.time.toMillis() > resource.data.createdAt + 86400000;
    }

    match /circle/{roomId} {
      allow read: if true;
      allow create: if validNewCircle();
      allow update: if validCircleUpdate();
      allow delete: if request.auth != null
                    || resource.data.playerOrder.size() <= 1
                    || request.time.toMillis() > resource.data.createdAt + 86400000;
    }

    match /errors/{errorId} {
      allow create: if request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 2000
                    && request.resource.data.timestamp is number;
      allow read, delete: if request.auth != null;
    }

    function validNewRoom() {
      let d = request.resource.data;
      return d.id == request.resource.id
        && d.status == 'lobby'
        && d.createdAt is int
        && d.hostId is string
        && d.hostId.size() > 0
        && d.players is map
        && d.playerOrder is list
        && d.playerOrder.size() >= 1
        && d.playerOrder.size() <= 12;
    }

    function validRoomUpdate() {
      let d = request.resource.data;
      let old = resource.data;
      return d.createdAt == old.createdAt
        && d.id == old.id
        && d.playerOrder is list
        && d.playerOrder.size() <= 12
        && validBusfahrenStatus(d.status);
    }

    function validBusfahrenStatus(s) {
      return s == 'lobby' || s == 'phase1' || s == 'phase2start'
          || s == 'phase2' || s == 'results' || s == 'phase3' || s == 'finished';
    }

    function validNewQuadrat() {
      let d = request.resource.data;
      return d.id == request.resource.id
        && d.status == 'lobby'
        && d.createdAt is int
        && d.hostId is string
        && d.hostId.size() > 0
        && d.players is map
        && d.playerOrder is list
        && d.playerOrder.size() >= 1
        && d.playerOrder.size() <= 12;
    }

    function validQuadratUpdate() {
      let d = request.resource.data;
      let old = resource.data;
      return d.createdAt == old.createdAt
        && d.id == old.id
        && d.playerOrder is list
        && d.playerOrder.size() <= 12
        && validQuadratStatus(d.status);
    }

    function validQuadratStatus(s) {
      return s == 'lobby' || s == 'playing' || s == 'distributing' || s == 'finished';
    }

    function validNewCircle() {
      let d = request.resource.data;
      return d.id == request.resource.id
        && d.status == 'lobby'
        && d.createdAt is int
        && d.hostId is string
        && d.hostId.size() > 0
        && d.players is map
        && d.playerOrder is list
        && d.playerOrder.size() >= 1
        && d.playerOrder.size() <= 12;
    }

    function validCircleUpdate() {
      let d = request.resource.data;
      let old = resource.data;
      return d.createdAt == old.createdAt
        && d.id == old.id
        && d.playerOrder is list
        && d.playerOrder.size() <= 12
        && validCircleStatus(d.status);
    }

    function validCircleStatus(s) {
      return s == 'lobby' || s == 'playing' || s == 'finished';
    }
  }
}
